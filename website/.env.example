# Configure securely on your host; never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Contact form: use a fresh send-only key and a verified sender domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Only enable public access/indexing after domain and end-to-end checks.
PUBLIC_SITE_ENABLED=false
SEO_INDEXING_ENABLED=false
SITE_URL=https://212-cleaning-production.up.railway.app
CONTACT_TO_EMAIL=
# Cloudflare Turnstile: restrict allowed hostnames to the launch domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
